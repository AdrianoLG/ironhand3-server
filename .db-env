# Rename file to .env

DATABASE_URL=#your database url#
DATABASE_NAME=#your database name#
ALLOWED_HOSTS=#allowed hosts in backend#
UPLOADS_URI=#uploads public folder#
JWT_SECRET=#secret used to sign JWT tokens#
JWT_EXPIRES_IN=#e.g. 7d#
FRONTEND_URL=#public url of the frontend, used in password reset emails#
SMTP_HOST=#smtp host, leave empty to log reset links to console instead of emailing#
SMTP_PORT=#smtp port#
SMTP_USER=#smtp user#
SMTP_PASS=#smtp password#
MAIL_FROM=#from address for emails#
